#include <iostream>
#include <vector>

using namespace std;

// Fungsi helper untuk mencetak array (Menggunakan tipe int biasa agar aman)
void printArray(const vector<int>& arr) {
    int n = arr.size();
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }
    cout << endl;
}

// 1. Bubble Sort
void bubbleSort(vector<int> arr) {
    int n = arr.size();
    cout << "\nData awal: "; printArray(arr); cout << endl;
    for (int i = 0; i < n; i++) {
        bool swapped = false;
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                swap(arr[j], arr[j + 1]);
                swapped = true;
            }
        }
        cout << "Iterasi ke-" << i + 1 << ": "; printArray(arr);
        if (!swapped) {
            cout << "Sudah terurut lebih awal." << endl;
            break;
        }
    }
    cout << "\nHasil Akhir: "; printArray(arr);
}

// 2. Selection Sort
void selectionSort(vector<int> arr) {
    int n = arr.size();
    cout << "\nData awal: "; printArray(arr); cout << endl;
    for (int i = 0; i < n; i++) {
        int min_idx = i;
        for (int j = i + 1; j < n; j++) {
            if (arr[j] < arr[min_idx]) min_idx = j;
        }
        swap(arr[i], arr[min_idx]);
        cout << "Iterasi ke-" << i + 1 << ": "; printArray(arr);
    }
    cout << "\nHasil Akhir: "; printArray(arr);
}

// 3. Insertion Sort
void insertionSort(vector<int> arr) {
    int n = arr.size();
    cout << "\nData awal: "; printArray(arr); cout << endl;
    for (int i = 1; i < n; i++) {
        int key = arr[i];
        int j = i - 1;
        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = key;
        cout << "Iterasi ke-" << i << ": "; printArray(arr);
    }
    cout << "\nHasil Akhir: "; printArray(arr);
}

// 4. Quick Sort Helper
int partition(vector<int>& arr, int low, int high) {
    int pivot = arr[high];
    int i = (low - 1);
    for (int j = low; j <= high - 1; j++) {
        if (arr[j] < pivot) {
            i++;
            swap(arr[i], arr[j]);
        }
    }
    swap(arr[i + 1], arr[high]);
    return (i + 1);
}

// Fungsi Utama Quick Sort
void quickSort(vector<int>& arr, int low, int high) {
    if (low < high) {
        int pi = partition(arr, low, high);
        cout << "Setelah partisi di pivot index " << pi << ": "; printArray(arr);
        quickSort(arr, low, pi - 1);
        quickSort(arr, pi + 1, high);
    }
}

// 5. Merge Sort Helper
void merge(vector<int>& arr, int l, int m, int r) {
    int n1 = m - l + 1;
    int n2 = r - m;
    vector<int> L(n1), R(n2);
    for (int i = 0; i < n1; i++) L[i] = arr[l + i];
    for (int j = 0; j < n2; j++) R[j] = arr[m + 1 + j];

    int i = 0, j = 0, k = l;
    while (i < n1 && j < n2) {
        if (L[i] <= R[j]) arr[k++] = L[i++];
        else arr[k++] = R[j++];
    }
    while (i < n1) arr[k++] = L[i++];
    while (j < n2) arr[k++] = R[j++];
}

// Fungsi Utama Merge Sort
void mergeSort(vector<int>& arr, int l, int r) {
    if (l < r) {
        int m = l + (r - l) / 2;
        mergeSort(arr, l, m);
        mergeSort(arr, m + 1, r);
        merge(arr, l, m, r);
        cout << "Proses Penggabungan: "; printArray(arr);
    }
}

int main() {
    int n;
    cout << "Masukkan jumlah data: ";
    cin >> n;

    vector<int> arr(n);
    for (int i = 0; i < n; i++) {
        cout << "Masukkan data ke-" << i + 1 << ": ";
        cin >> arr[i];
    }

    cout << "\n=== PILIH METODE SORTING ===\n";
    cout << "1. Bubble Sort\n2. Selection Sort\n3. Insertion Sort\n4. Quick Sort\n5. Merge Sort\n";
    int pilihan;
    cout << "Pilihan (1-5): ";
    cin >> pilihan;

    switch (pilihan) {
        case 1: bubbleSort(arr); break;
        case 2: selectionSort(arr); break;
        case 3: insertionSort(arr); break;
        case 4:
            cout << "\nData awal: "; printArray(arr); cout << endl;
            quickSort(arr, 0, n - 1);
            cout << "\nHasil Akhir: "; printArray(arr);
            break;
        case 5:
            cout << "\nData awal: "; printArray(arr); cout << endl;
            mergeSort(arr, 0, n - 1);
            cout << "\nHasil Akhir: "; printArray(arr);
            break;
        default: cout << "Pilihan tidak valid.\n";
    }
    return 0;
}
